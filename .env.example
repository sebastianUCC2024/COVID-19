# MySQL local: completa los valores en el entorno de ejecución.
LOCAL_DB_HOST=
LOCAL_DB_PORT=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=

# MySQL Aiven: completa los valores en el entorno de ejecución.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_USER=
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=

# Configura un token aleatorio para habilitar el reseteo.
TABLE_RESET_TOKEN=

# Configuración opcional de Spark.
