# MySQL local
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=covid19

# MySQL Aiven (usa los valores de la consola del servicio)
AIVEN_DB_HOST=
AIVEN_DB_PORT=25060
AIVEN_DB_USER=
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=

# Opcional: Spark corre localmente dentro del proceso por defecto
# SPARK_MASTER=local[*]
# SPARK_LOG_LEVEL=ERROR
# SPARK_IVY_DIR=/tmp/spark-ivy
# Para un Spark master remoto, define SPARK_DRIVER_HOST y SPARK_DRIVER_BIND_ADDRESS
# con direcciones alcanzables desde los executors.
