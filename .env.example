# MySQL local: completa los valores en el entorno de ejecución.
LOCAL_DB_HOST=
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=covid19

# MySQL Aiven Cloud: variables requeridas para despliegue en Railway / Docker.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=defaultdb

# Token de seguridad para habilitar el reseteo de la tabla en Aiven (mínimo 32 caracteres).
TABLE_RESET_TOKEN=

# Configuración de memoria y rendimiento de PySpark (ajustable por contenedor Docker).
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MAX_RESULT_SIZE=1g
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=INFO

# Optimización de carga JDBC hacia Aiven Cloud.
SPARK_JDBC_BATCH_SIZE=10000
SPARK_JDBC_CONNECT_TIMEOUT_MS=60000
SPARK_JDBC_SOCKET_TIMEOUT_MS=60000

# Directorio de caché Maven / Ivy para Spark Connector.
# SPARK_IVY_DIR=/tmp/spark-ivy

# Opciones para Spark Master remoto (si aplica).
# SPARK_DRIVER_HOST=
# SPARK_DRIVER_BIND_ADDRESS=
